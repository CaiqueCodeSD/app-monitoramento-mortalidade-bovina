<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card_registro"
    android:elevation="4dp">


    <ImageView
        android:id="@+id/imgFoto"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_imagem_registro"
        android:clipToOutline="true"
        android:src="@drawable/ic_launcher_foreground" />


    <TextView
        android:id="@+id/tvData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Data: 31/03/2026" />


    <TextView
        android:id="@+id/tvCausa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Causa: Doença"
        android:layout_marginTop="4dp"/>


    <TextView
        android:id="@+id/tvObservacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Observação: ..."
        android:layout_marginTop="4dp"/>


    <TextView
        android:id="@+id/tvLatitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Latitude: Não capturada"/>


    <TextView
        android:id="@+id/tvLongitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Longitude: Não capturada"/>

    <!-- STATUS SINCRONIZAÇÃO -->
    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgStatusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_circle"
            android:contentDescription="@string/desc_status_sincronizacao"/>

        <TextView
            android:id="@+id/tvStatusTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/status_sincronizado"/>

    </LinearLayout>

</LinearLayout>